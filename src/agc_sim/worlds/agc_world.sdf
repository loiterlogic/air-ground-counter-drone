    <!-- 物理：对齐旧树步长/更新率 -->
    <physics name="default_physics" default="1" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- 系统插件：**显式全量声明且按顺序**（W3 打补丁：补 PX4 必需插件）。
         顺序与 PX4 官方 Tools/simulation/gz/worlds/default.sdf 一致：
         Physics → UserCommands → SceneBroadcaster → Contact → Imu → AirPressure
         → ApplyLinkWrench → NavSat → Sensors。
         原因：默认 server.config 只含前三个；若仅额外声明 Sensors 而其余靠默认，
         插件加载顺序会错位（Sensors 先于 Physics/SceneBroadcaster），导致 server 在加载阶段挂死。
         Contact / Imu / AirPressure / ApplyLinkWrench / NavSat 为 PX4 SITL 挂入本 world 所需（W3-a，ADR-0019）。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 视觉：**关闭默认地面网格**（P1-1；来源：用户 2026-10-29 15:39 「GUI 地图中间的网格不需要」）。
         Gazebo 的地面网格来自 world 的 `<scene><grid>`（SDF 缺省 true），**不是** `ground_plane`
         的几何——它由 GUI 按 cell 大小绘制，不参与碰撞 / 物理 / 任何真源几何。
         故此处**只**在视觉层关闭它：`<grid>false</grid>`。物理（`<physics>`）、地面碰撞
         （`ground_plane` 的 `<collision>`）与静态障碍真源（`config/world_geometry.yaml` /
         `config/maps/*.yaml`）**全部不动**。核查见 `tests/w6_geometry_check.py` 断言 (n)。 -->
    <scene>
      <grid>false</grid>
    </scene>

    <!-- 视觉：GUI **相机预设**（P1-1；来源：用户 2026-10-29「地图是斜的 / 截图取证」问题）。
         官方可复现写法取自 PX4 官方世界 `Tools/simulation/gz/worlds/baylands.sdf` 的
         `<gui><plugin MinimalScene><camera_pose>`（同为 GZ Sim 8）。此前靠在 GUI 里累积
         `/gui/move_to/pose` 拖视角，**不可复现**、每次截图朝向都不同（用户看到的就是斜的）。
         此处固定为**正俯视平面图**：相机 (0,0,118)、roll=0、pitch=+π/2、**yaw=+π/2** →
         视线铅直向下、画面 **+y（北）朝上、+x（东）朝右**（标准平面图朝向）；高度 118 m
         使 100×100 作业区带边距完整入画。
         yaw 为何是 +π/2：GZ 相机前向 = 局部 +x、画面向上 = 局部 +z；pitch=+π/2 使前向朝下后，
         局部 +z 落到世界 +x（即"东朝上"）。2026-10-29 用同姿态相机传感器**实测**：
         yaw=0 → 东朝上；yaw=+π/2 → 北朝上（对渲染图与几何投影做 IoU 拟合，命中标准朝向）。
         纯视觉：不改物理、光照、传感器系统、spherical_coordinates，也不改几何真源。
         核查断言 (n) 只关 `<scene><grid>` 与 `ground_plane`/`physics`，本块不影响它。 -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.45 0.45 0.45</ambient_light>
        <background_color>0.78 0.82 0.86</background_color>
        <!-- P2-1 round-4（2026-10-31）：相机高度 118 → 85 m。118 m 时 100×100 作业区只占
             画面约 65%，用户反馈"太远看不清"；85 m 使其约占 90%（边距仍在）。
             **纯 GUI 视觉**：只改视图相机高度，不碰物理 / 传感器 / 几何真源 / 光照。 -->
        <!-- 2026-11-05（用户裁定）：相机高度 85 → **50 m**。
             原因：用户实测"GUI 里看不见我方无人机"。85 m 正俯视、默认 FOV 60° 时，
             视野地面宽 ≈98 m、像素密度 ≈8.5 px/m；x500 对角仅 0.35 m → **约 3 px**，
             已到不可辨识量级（对照：车 1.0 m ≈ 8.5 px、目标高亮球 1.2 m ≈ 10 px）。
             50 m 把像素密度提到 ≈14.4 px/m（x500 ≈ 5 px），并与我方机/车新增的
             **青色 1.2 m 高亮球**（agc_x500.sdf / agc_car.sdf.xacro）配套使用。
             代价（如实）：视野地面宽 ≈58 m，100×100 作业区**不再完整入画**、四角出画；
             这是用户明确的取舍（先看清机体，后看全场）。
             **纯 GUI 视觉**：只改视图相机高度，不碰物理 / 传感器 / 几何真源 / 光照。 -->
        <camera_pose>0 0 50 0 1.5708 1.5708</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="MarkerManager" name="Marker manager"/>
      <plugin filename="SelectEntities" name="Select Entities"/>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities"/>
      <plugin filename="Spawn" name="Spawn Entities"/>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"/>
      <plugin name="World control" filename="WorldControl">
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>

      <!-- Screenshot（P2-1 α，2026-10-31）：**GUI 取证用；不进入仿真、不改变任何物理/感知口径**。
           存在的唯一理由：本块（<gui>）覆盖了发行版默认 gui.config，其中不含本插件，
           于是 /gui/screenshot 服务不上线、无法从 3D 视图相机取真实帧（round-3 实测 0 帧）。
           它只注册一个 GUI 服务（把相机视图存 PNG），**不订阅话题、不发命令、不碰模型位姿**，
           因此与唯一执行口（#execution-port）和 C3 口径无关。
           取证方式见 scripts/demo/gui_capture.py（`data` 传**目录**，服务立即返回 true，
           存盘在下一个 Render 事件 → 必须轮询新增 png）。
           属性照抄发行版 gui.config 的同名块（仅影响工具条外观，不影响取到的画面）。 -->
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- 静态障碍 pole_1 / pole_2 **不**在本 base world 内：几何真源见 config/world_geometry.yaml，
         由 world_bringup.launch.py 生成运行期世界时按 world_obstacles 注入（ADR-0007）。 -->

    <!-- WGS84 / ENU 基准（W3 打补丁）：PX4 NavSat 等所需，与 agc_world 的 ENU 基准一致。 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>