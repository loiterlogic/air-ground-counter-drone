<?xml version="1.0" ?>
<!--
  agc_world —— AGC 空地协同的唯一世界（GZ Sim / Harmonic，W2-min）

  **base world**（ADR-0007）：本文件**不含**静态障碍 `pole_*` 块，是
  障碍生成所依据的 base。静态障碍几何的唯一真源为 `config/world_geometry.yaml`，
  由 `world_bringup.launch.py` 按 `world_obstacles`（`static`/`none`）**注入 / 不注入**
  障碍模型生成运行期世界（`none` 直接用本 base；`static` 生成 base + pole 临时世界）。

  设计要点（对齐旧树行为事实，WHAT；实现为 GZ Sim 全新重写，HOW 不继承）：
    * 单一世界：障碍在运行期由场景复位 spawn / toggle，不维护"静态/动态"两份 world。
    * 基准坐标系 ENU（+x 东、+y 北、+z 上），单位 m / m/s / rad。
    * 地面与光源**内联**定义（不依赖 model://sun / ground_plane 资源），保证自包含。
    * 物理引擎为 dart（GZ Sim 8/Harmonic 不再支持 ODE）；步长与更新率对齐旧树
      （max_step_size=0.004、real_time_update_rate=250），改则须重新标定 /clock。
    * 地面车 agc_car 与目标 intruder_uav **不在本 world 内**：由 world_bringup.launch.py
      经 ros_gz_sim create 按 config/*.yaml 参数 spawn（参数单一来源）。
    * 静态障碍 pole_1 / pole_2 的形态（0.3×0.3×3）沿用旧树；pose 于 **W3 打补丁**重排入 80×80 作业区（ADR-0019）。
      几何值现**只**存于 `config/world_geometry.yaml`（ADR-0007）。
    * **W3 打补丁**：补 PX4 必需系统插件 + `spherical_coordinates`；作业区放大到 80×80（车/目标 spawn 分离 ~30 m）。
-->
<sdf version="1.8">
  <world name="agc_world">

    <!-- 光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面（内联平面）——**场区基层**：冷灰混凝土，标量 PBR（metalness 0 / roughness 0.95）。
         2026-10-29 用户裁定「建筑和地面精细度不高」→ 地面分为「基层 + 道路 + 场坪」三层
         （见下），基层提亮以与沥青路面形成对比。**纯视觉**：碰撞仍是同一张 200×200 平面，
         不参与障碍真源 / 空中安全层 / 占位栅格。 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.95</roughness>
                <albedo_map>/home/chen/AGC/install/agc_sim/share/agc_sim/materials/albedo/concrete_ground.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 地面分层（2026-10-29）：沥青道路 + 混凝土场坪 =====
         设计与纪律（用户要求「地面精细度」；先学后做 → 本机 sdformat 1.11 material.sdf 确认
         `<pbr><metal><metalness>|<roughness>` 是**标量**字段，无需贴图 → 不引入外部资产）：
           * 三者都是**地面**，不是静态障碍：**不进**几何真源 `obstacles`、不进空中安全层、
             不进感知占位栅格；仅在 `agc_world.sdf` 内联，与 `ground_plane` 同类。
           * 视觉与碰撞同源（每个几何片段同时注入 collision 与 visual），**不做**装饰性无碰撞块。
           * 厚度 3–4 mm、抬升 2–6 mm：避免与基层共面 z-fighting；对车（轮半径 0.178 m）
             与物理无实质影响。
           * 布局：一圈**环形主路**（东西各一条 + 南北各一条）+ 南门支路 + 北侧支路 + 中央
             混凝土作业坪 + 两处场坪（维修区 / 配送库前）。道路从建筑之间穿过，即现实场站的
             内部道路网格（先学后做：Nav2 warehouse 世界的通道式布局同理）。 -->
    <model name="road_ring_w">
      <static>true</static>
      <pose>-30 0 0.002 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>9 58 0.004</size></box></geometry></collision>
