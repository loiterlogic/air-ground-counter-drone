<?xml version="1.0"?>
<model>
  <name>agc_x500</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>AGC</name>
    <email>noreply@example.invalid</email>
  </author>
  <description>
    PX4 x500 plus a GUI-only identification highlight sphere (cyan, 1.2 m).
    The sphere has no collision and is placed above the ground lidar scan plane,
    so it cannot affect physics, contacts or the safety layer. It exists purely
    so the own UAV is visible in the Gazebo GUI top-down view.
  </description>
</model>
