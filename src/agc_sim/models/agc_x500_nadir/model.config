<?xml version="1.0"?>
<model>
  <name>agc_x500_nadir</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>AGC</name>
    <email>noreply@example.invalid</email>
  </author>
  <description>
    PX4 x500 with an opt-in nadir (straight-down) camera. Used only when the
    AGC own-vehicle PX4 process is launched with px4_sim_model:=gz_agc_x500_nadir.
    The camera is evidence / mapping only; it has no consumers in the task chain
    (target identification stays truth-derived via gt_adapter). See ADR-0030.
  </description>
</model>
