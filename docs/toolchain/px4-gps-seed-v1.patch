 bool SensorGpsSim::init()
 {
+	// The launch layer supplies AGC_PX4_SIM_SEED per PX4 instance.  Keep a
+	// deterministic fallback for standalone PX4 launches, but reject malformed
+	// values instead of silently falling back to an unrelated stream.
+	const char *seed_text = std::getenv("AGC_PX4_SIM_SEED");
+	if (seed_text == nullptr || seed_text[0] == '\0') {
+		PX4_WARN("AGC_PX4_SIM_SEED unset; using deterministic standalone seed 1");
+		_rng_state = 1u;
+
+	} else {
+		errno = 0;
+		char *end = nullptr;
+		const unsigned long parsed = std::strtoul(seed_text, &end, 10);
+
+		if (errno == ERANGE || end == seed_text || *end != '\0' ||
+			parsed > std::numeric_limits<uint32_t>::max()) {
+			PX4_ERR("invalid AGC_PX4_SIM_SEED='%s' (expected uint32 decimal)", seed_text);
+			return false;
+		}
+
+		// xorshift32 has an absorbing zero state; map it to a fixed non-zero
+		// state while retaining the documented seed in the launch manifest.
+		_rng_state = static_cast<uint32_t>(parsed);
+		if (_rng_state == 0u) {
+			_rng_state = 0x6D2B79F5u;
+		}
+	}
+
+	PX4_INFO("GPS simulation RNG seed=%u", static_cast<unsigned>(_rng_state));
 	ScheduleOnInterval(125_ms); // 8 Hz
 	return true;
 }
