# ===== colcon 构建产物 =====
/build/
/install/
/log/

# ===== 外部工具链（忽略内容，仅放行 README 索引）=====
/toolchain/*
!/toolchain/README.md

# ===== 归档旧树（只读，不纳入版本控制）=====
/reference/

# ===== 实验产物：仅本地保留，不入版本库（ADR-0025）=====
/experiments/
/experiments/_archive/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
.pytest_cache/

# ===== 过程草稿（家见 docs/conventions/目录与命名规范.md）=====
/docs/temp/

# ===== 编辑器本地设置 =====
.vscode/

# ===== 已退役的本地 Agent / 交接产物（ADR-0025 / ADR-0026）=====
/.trae/
/.coordination/wake/

# ===== 协作台账：逐轮过程物与锁文件不入库（ADR-0025 / ADR-0026）=====
# 结论归 ADR / docs/ / CURRENT.md；逐轮 request/report/review 与证据按协作协议
# 结档即删，不进长期档案。锁文件是**运行时状态**，入库只会让检出带上别人的锁。
/.coordination/task/
/.coordination/drafts/
/.coordination/locks/*.lock
/.coordination/STOP-*.md
