# ===== colcon 构建产物 =====
/build/
/install/
/log/

# ===== 外部工具链（忽略内容，仅放行 README 索引）=====
/toolchain/*
!/toolchain/README.md

# ===== 归档旧树（只读，不纳入版本控制）=====
/reference/

# ===== 实验产物：仅本地保留，不入版本库（ADR-0081）=====
/experiments/

# ===== 证据不可变归档：大归档与侧车不入 git（ADR-0064）=====
/experiments/_archive/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]

# ===== 过程草稿：只放临时物，不入库（家见 docs/conventions/目录与命名规范.md）=====
/docs/temp/

# ===== 编辑器 / IDE 本地设置（个人偏好，不入库）=====
.vscode/

# ===== 本地 Agent 工作流产物（公开仓库不发布，ADR-0081）=====
# Trae 已于 2026-10-29 退役（ADR-0105）：specs 迁至 docs/archive/specs/、skills 迁至 .agents/skills/。
# 保留本行只为不让残留的本地 .trae/ 目录误入库；内容已不在此路径。
/.trae/

# ===== 历史 workstream 规格：仍不发布，仅本机保留（ADR-0081 / ADR-0105）=====
# 精确到目录本身，不影响 docs/archive/ 下的其他归档（runbook / ros1 基线）。
/docs/archive/specs/

# ===== 历史交接叫醒的运行产物：回执与日志（机制已于 2026-10-28 退役，见 ADR-0102）=====
/.coordination/wake/
